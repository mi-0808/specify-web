# ------------------------------------------------------------
# Supabase（必須）
# ------------------------------------------------------------
# Supabase ダッシュボード → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 収集処理の書き込み用（サーバー専用・絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# 部屋の自動収集（docs/specify-design.md）
# ------------------------------------------------------------
# YouTube Data API v3 のキー。Google Cloud の specify-web プロジェクトで発行（YouTube Data API v3 だけに制限済み）
YOUTUBE_API_KEY=

# /api/cron/collect を守るランダムな値（openssl rand -hex 32 で作る）。Vercel Cron が Authorization ヘッダーに付けて呼ぶ
CRON_SECRET=

# Google ログイン（Google Cloud の OAuth クライアント）。ID は公開してよい値、シークレットはサーバーだけで使う
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
