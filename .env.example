# ------------------------------------------------------------
# Supabase（必須）
# ------------------------------------------------------------
# Supabase ダッシュボード → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 管理者APIがRLSを跨いで書き込むために使用（サーバー専用・絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# アプリ基本設定（必須）
# ------------------------------------------------------------
# メール内リンクやサーバー間fetchの起点。末尾スラッシュなし
# 例: http://localhost:3000 / https://specify.example.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 管理画面（/admin・/b/admin）にアクセスできるメールアドレス（カンマ区切り）
# 先頭のアドレスが新規スキャンの通知先になる
ADMIN_EMAILS=admin@example.com

# ------------------------------------------------------------
# AI（任意・未設定でもWoZ運用は可能）
# ------------------------------------------------------------
# Google AI Studio で発行する（無料枠あり）: https://aistudio.google.com/apikey
# 用途: POST /api/analyze（収納提案）、POST /api/ai/suggest-b・suggest-c（マーカー入力補助）
# 無料枠は入力内容がGoogleの製品改善に利用される条件付き → docs/ai-gemini-plan.md
GEMINI_API_KEY=

# 使用モデル（省略時は gemini-3.6-flash）。モデル終息時はここだけ差し替える。
GEMINI_MODEL=

# ------------------------------------------------------------
# メール通知（任意・未設定なら通知はスキップされる）
# ------------------------------------------------------------
# https://resend.com/api-keys（無料プラン: 月3,000通）
RESEND_API_KEY=

# 送信元アドレス。Resendで検証済みドメインを設定する
# 未設定時は onboarding@resend.dev にフォールバックする（開発用途のみ）
RESEND_FROM="Specify <noreply@example.com>"
